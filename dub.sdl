name "tgng"
description "Telegram API for clients and bots"
authors "Denis Feklushkin"
license "proprietary"
targetType "executable"
targetName "tgng"

dependency "tgcapi" path="tgng-tgcapi"

subPackage {
	name "tgcapi"
	description "Generated D bindings for the Telegram API client"
	targetType "library"
}

subPackage {
	name "tlgen"
	description "TL scheme to D code generator"
	targetType "executable"
	targetName "tlgen"
}

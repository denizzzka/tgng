name "tgng"
description "Telegram API for clients and bots"
authors "Denis Feklushkin"
license "proprietary"
targetType "executable"
targetName "tgng"

dependency "tgcapi" path="subprojects/tgcapi"

subPackage {
	name "tlgen"
	description "TL scheme to D code generator"
	targetType "executable"
	targetName "tlgen"
	sourcePaths "subprojects/tlgen/source"
}

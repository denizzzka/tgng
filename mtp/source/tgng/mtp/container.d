/// MTProto 2.0 encrypted message container.
///
/// A message is serialised as `salt | session_id | msg_id | seq_no | length |
/// body | padding`, then wrapped as `auth_key_id | msg_key | AES-IGE(data)`.
/// The key and IV come from the SHA-1 KDF in `crypto.d`.
module tgng.mtp.container;

import tgng.mtp.crypto: CryptoException, aesIgeDecrypt, aesIgeEncrypt,
	deriveAesKeyIv, hmacSha256, randomBytes, sha1, sha256;

import std.array: appender;
import std.bitmanip: littleEndianToNative, nativeToLittleEndian;
import std.exception: enforce;

/// Raised when a message cannot be built or decoded.
class ContainerException : Exception
{
	this(string msg, string file = __FILE__, size_t line = __LINE__) @safe pure nothrow
	{
		super(msg, file, line);
	}
}

/// Plain fields of one MTProto message.
struct PlainMessage
{
	long salt;
	long sessionId;
	long messageId;
	int seqNo;
	ubyte[] body;
}

/// Serializable text of a message, as laid out before encryption.
ubyte[] serializePlain(ref const PlainMessage msg) @safe
{
	auto buf = appender!(ubyte[])();
	buf.put(nativeToLittleEndian(msg.salt)[]);
	buf.put(nativeToLittleEndian(msg.sessionId)[]);
	buf.put(nativeToLittleEndian(msg.messageId)[]);
	buf.put(nativeToLittleEndian(msg.seqNo)[]);
	buf.put(nativeToLittleEndian(cast(int) msg.body.length)[]);
	buf.put(msg.body);
	return buf.data;
}

/// Parses the encrypted part of a message.
PlainMessage parsePlain(const(ubyte)[] data) @safe
{
	enforce!ContainerException(data.length >= 32, "message is shorter than its header");

	PlainMessage msg;
	msg.salt = littleEndianToNative!long(data[0 .. 8]);
	msg.sessionId = littleEndianToNative!long(data[8 .. 16]);
	msg.messageId = littleEndianToNative!long(data[16 .. 24]);
	msg.seqNo = littleEndianToNative!int(data[24 .. 28]);
	immutable int length = littleEndianToNative!int(data[28 .. 32]);
	enforce!ContainerException(length >= 0, "negative message length");
	enforce!ContainerException(32 + cast(size_t) length <= data.length, "message body is truncated");
	msg.body = data[32 .. 32 + length].dup;
	return msg;
}

/// Builds a full MTProto 2.0 encrypted message.
///
/// `authKeyId` is the first 8 bytes of SHA-1 over the auth key. Padding is
/// random and fills the payload to a multiple of 16 bytes.
ubyte[] encryptMessage(ref const PlainMessage msg, const(ubyte)[] authKey, long authKeyId,
	bool clientToServer = true) @safe
{
	enforce!ContainerException(authKey.length == 256, "auth_key must be 256 bytes");

	auto plain = appender!(ubyte[])();
	plain.put(serializePlain(msg));
	// MTProto 2.0 requires padding of 12..1024 bytes, not just block alignment.
	auto padding = (16 - plain.data.length % 16) % 16;
	if (padding < 12)
		padding += 16;
	auto extra = new ubyte[padding];
	randomBytes(extra);
	plain.put(extra);

	auto data = plain.data;
	enforce!ContainerException(data.length % 16 == 0, "padded message is not block-aligned");

	immutable size_t x = clientToServer ? 0 : 8;
	ubyte[] keySource;
	keySource ~= authKey[88 + x .. 120 + x];
	keySource ~= data;
	immutable digest = sha256(keySource);
	ubyte[16] msgKey = digest[8 .. 24];

	auto kdf = deriveAesKeyIv(msgKey[], authKey, clientToServer);
	auto encrypted = data.dup;
	auto iv = kdf.iv;
	aesIgeEncrypt(encrypted, kdf.key, iv);

	auto result = appender!(ubyte[])();
	result.put(nativeToLittleEndian(authKeyId)[]);
	result.put(msgKey[]);
	result.put(encrypted);
	return result.data;
}

/// Decodes an MTProto 2.0 message, checking the message key.
PlainMessage decryptMessage(const(ubyte)[] packet, const(ubyte)[] authKey,
	bool clientToServer = false) @safe
{
	enforce!ContainerException(packet.length >= 24 + 16, "packet is too short");
	enforce!ContainerException((packet.length - 24) % 16 == 0, "encrypted part is not block-aligned");

	immutable authKeyId = littleEndianToNative!long(packet[0 .. 8]);
	enforce!ContainerException(authKeyId == authKeyIdOf(authKey), "unexpected auth_key_id");

	ubyte[16] msgKey = packet[8 .. 24];
	auto kdf = deriveAesKeyIv(msgKey[], authKey, clientToServer);

	auto data = packet[24 .. $].dup;
	auto iv = kdf.iv;
	aesIgeDecrypt(data, kdf.key, iv);

	immutable size_t x = clientToServer ? 0 : 8;
	ubyte[] keySource;
	keySource ~= authKey[88 + x .. 120 + x];
	keySource ~= data;
	immutable digest = sha256(keySource);
	enforce!ContainerException(digest[8 .. 24] == msgKey[], "message key mismatch");

	return parsePlain(data);
}

/// Returns the `auth_key_id` for an auth key.
long authKeyIdOf(const(ubyte)[] authKey) @safe
{
	enforce!ContainerException(authKey.length == 256, "auth_key must be 256 bytes");
	immutable digest = sha1(authKey);
	return littleEndianToNative!long(digest[12 .. 20]);
}

// Fixtures are generated by encryptMessage itself for the round-trip cases;
// the explicit vector pins the wire layout.
@safe unittest // encrypt/decrypt round trip
{
	auto authKey = new ubyte[256];
	foreach (i; 0 .. authKey.length)
		authKey[i] = cast(ubyte) i;

	PlainMessage msg;
	msg.salt = 0x0102030405060708;
	msg.sessionId = 0x1112131415161718;
	msg.messageId = 0x2122232425262728;
	msg.seqNo = 3;
	msg.body = cast(ubyte[]) "hello".dup;

	immutable id = authKeyIdOf(authKey);
	auto packet = encryptMessage(msg, authKey, id);
	enforce((packet.length - 24) % 16 == 0, "packet length is block-aligned");
	enforce(packet[0 .. 8] == nativeToLittleEndian(id), "auth_key_id is written first");

	auto decoded = decryptMessage(packet, authKey, true);
	enforce(decoded.salt == msg.salt, "salt round trip");
	enforce(decoded.sessionId == msg.sessionId, "session_id round trip");
	enforce(decoded.messageId == msg.messageId, "msg_id round trip");
	enforce(decoded.seqNo == msg.seqNo, "seq_no round trip");
	enforce(decoded.body == msg.body, "body round trip");
}

@safe unittest // padding is block-aligned and at least 12 bytes
{
	auto authKey = new ubyte[256];
	PlainMessage msg;
	msg.body = new ubyte[1];
	auto packet = encryptMessage(msg, authKey, 0);
	enforce((packet.length - 24) % 16 == 0, "encrypted part is block-aligned");
	enforce(packet.length - 24 - 32 >= 12, "padding is at least 12 bytes");
}

@safe unittest // tampered msg_key is rejected
{
	auto authKey = new ubyte[256];
	PlainMessage msg;
	msg.body = cast(ubyte[]) "data".dup;
	auto packet = encryptMessage(msg, authKey, 0);
	packet[8] ^= 0xFF;

	bool thrown;
	try
		decryptMessage(packet, authKey);
	catch (ContainerException)
		thrown = true;
	enforce(thrown, "corrupted msg_key was accepted");
}

@safe unittest // hmacSha256 is exported alongside the container helpers
{
	enforce(hmacSha256(cast(const(ubyte)[]) "k", cast(const(ubyte)[]) "d").length == 32);
}

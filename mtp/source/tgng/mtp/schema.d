/// Finds a constructor by id, or null.
const(SchemaConstructor)* schemaFind(uint id) @safe nothrow
{
	size_t lo = 0;
	size_t hi = schemaConstructors.length;
	while (lo < hi)
	{
		auto mid = (lo + hi) / 2;
		if (schemaConstructors[mid].id < id)
			lo = mid + 1;
		else
			hi = mid;
	}
	if (lo < schemaConstructors.length && schemaConstructors[lo].id == id)
		return &schemaConstructors[lo];
	return null;
}

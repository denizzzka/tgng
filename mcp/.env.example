# Telegram credentials for tgng-mcp (user mode).
# Copy to .env, fill in, and keep the copy out of git.
TG_API_ID=
TG_API_HASH=
TG_PHONE=+10000000000

# Optional SOCKS5 proxy for the MTProto connection, host:port.
TG_PROXY=

# Session file written by `tgng-mcp login`.
TG_SESSION=~/.config/tgng/mcp.session
